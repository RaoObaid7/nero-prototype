# Local PostgreSQL database running in Docker
DATABASE_URI=postgresql://postgres:postgres@localhost:5433/nero_prototype_dev

# Payload secret for JWT & cookies
PAYLOAD_SECRET=super-secret-payload-key-change-in-prod-32chars

# Application URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Authorized Draft Preview secret
PREVIEW_SECRET=preview-secret-key-32-chars-minimum-length
